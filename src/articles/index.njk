---
layout: base.njk
title: Articles | Aden Eilers
---
  <!-- NAVBAR -->
  <nav class="navBar">
    <div class="innerContainer">
      <a href="/" class="logo">
        <h3>Aden Eilers</h3>
      </a>
      <div class="d-flex align-items-center">
        <button class="btn btn-link text-dark me-3" id="darkModeToggle" onclick="toggleDarkMode()" title="Toggle dark mode">
          <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" fill="currentColor" viewBox="0 0 16 16">
            <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278"/>
          </svg>
        </button>
        <a href="/" class="btn btnWhite">Home</a>
      </div>
    </div>
  </nav>

  <!-- ARTICLES LISTING -->
  <section class="container pt-5 pb-5">
    <h1 class="mb-4">Articles</h1>
    <div class="row">
      {%- for article in collections.articles | reverse -%}
      <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
          <div class="card-body">
            <h4 class="card-title">{{ article.data.title }}</h4>
            <p class="text-muted small">{{ article.date | date }}</p>
            <div class="mb-3">
              {%- for tag in article.data.tags -%}
              <span class="badge bg-secondary">{{ tag }}</span>
              {%- endfor -%}
            </div>
            <p class="card-text">{{ article.templateContent | stripHtml | truncate(150) }}</p>
            <a href="{{ article.url }}" class="btn btnProjects">Read More</a>
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </section>

