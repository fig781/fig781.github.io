<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="initial-scale=1.0, width=device-width">
  <title>{{ title }} | Aden Eilers</title>
  <link rel="stylesheet" href="/styles.css">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .article-content {
      min-height: 60vh;
      padding: 2rem 0;
    }
    .article-content h1 {
      margin-bottom: 0.5rem;
    }
    .article-meta {
      color: #6c757d;
      margin-bottom: 1.5rem;
    }
    .article-tags {
      margin-bottom: 2rem;
    }
    .back-link {
      display: inline-block;
      margin-bottom: 1.5rem;
    }
  </style>
</head>
<body>
  <!-- NAVBAR -->
  <nav class="navBar">
    <div class="innerContainer">
      <a href="/" class="logo">
        <h3>Aden Eilers</h3>
      </a>
      <div>
        <a href="/" class="btn btnWhite">Home</a>
      </div>
    </div>
  </nav>

  <!-- ARTICLE CONTENT -->
  <section class="article-content container py-5">
    <a href="/articles/" class="back-link">&larr; Back to Articles</a>
    
    <h1>{{ title }}</h1>
    
    {% if pubDate %}
    <p class="article-meta">Published on {{ pubDate }}</p>
    {% endif %}
    
    {% if tags %}
    <div class="article-tags">
      {% for tag in tags %}
      <span class="badge bg-secondary me-1">{{ tag }}</span>
      {% endfor %}
    </div>
    {% endif %}
    
    <div class="article-body">
      {{ content | safe }}
    </div>
  </section>

